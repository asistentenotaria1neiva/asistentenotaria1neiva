# Variables para la instalación LOCAL (servidor de la notaría, sin Supabase ni Vercel).
# Copie este archivo como .env en la carpeta de la aplicación (C:\Escrituracion\app\.env) y complete los valores.
# Ver docs/instalacion_local.md.

# --- Base de datos: PostgreSQL instalado en este mismo servidor ---
# Sin pgbouncer ni connection_limit=1 (eso era para el pooler de Supabase).
DATABASE_URL=postgresql://escrituracion:CAMBIE_ESTA_CLAVE@127.0.0.1:5432/escrituracion

# --- Claves: las MISMAS que tenía Vercel. Con otra CLAVE_MAESTRA los archivos traídos de Supabase no se pueden leer,
# y con otra CLAVE_FIRMA los equipos tendrían que registrarse de nuevo.
CLAVE_MAESTRA=
CLAVE_FIRMA=

# --- API de Claude: igual que en Vercel ---
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_ADMIN_KEY=
CLAUDE_MODELO_DOCUMENTOS=
CLAUDE_MODELO_REDACCION=
CLAUDE_MODELO_RESPALDO=
CLAUDE_ESFUERZO_DOCUMENTOS=
CLAUDE_ESFUERZO_REDACCION=
CLAUDE_FALLBACKS=
CLAUDE_CONCURRENCIA=

# --- Red ---
# Red de la oficina (los equipos llegan con su IP privada, no con la pública). Ajuste si la red es otra.
IPS_OFICINA=192.168.2.0/24
# true: Caddy (local/Caddyfile) es el único que entra a la aplicación y le pasa la IP real en X-Real-IP
CONFIAR_EN_PROXY=true
# La aplicación se llama a sí misma para encadenar las etapas: directo, sin pasar por Caddy ni por HTTPS
URL_APLICACION=http://127.0.0.1:3000

# Equipos ya aprobados en Vercel: al ingresar desde https://servidor se reconocen solos (misma huella del
# navegador y el mismo usuario ya había entrado desde ese equipo) hasta esta fecha. Vacía = apagado.
RECONOCER_EQUIPOS_HASTA=2026-12-31

# --- Almacenamiento: carpeta local (SUPABASE_URL vacía). Fuera de OneDrive. ---
SUPABASE_URL=
SUPABASE_CLAVE_SERVICIO=
RUTA_ALMACENAMIENTO=C:\Escrituracion\almacenamiento

# --- Conversión a PDF (opcional) ---
PDF_CONVERSOR_URL=

# --- Avisos push: los mismos valores de Vercel (si cambian, cada equipo vuelve a activar los avisos) ---
VAPID_PUBLICA=
VAPID_PRIVADA=
VAPID_CONTACTO=

# --- Limpieza automática ---
# Los valores por defecto (30 días / 3 días / 550 MB) eran para no pasar del 1 GB gratis de Supabase.
# En el disco local hay espacio de sobra: se conservan las escrituras ~10 años y los PDF soporte 1 año.
LIMPIEZA_ESCRITURAS_DIAS=3650
LIMPIEZA_PDF_DIAS=365
LIMPIEZA_PDF_MAXIMO_MB=100000
