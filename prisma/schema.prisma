// Modelo de datos – Asistente de escrituración, Notaría Primera del Círculo de Neiva.
// Base de datos: PostgreSQL (solo accesible desde el servidor de la aplicación).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Roles y usuarios

enum Rol {
  ADMINISTRADOR
  REVISOR
  DIGITADOR
}

enum EstadoUsuario {
  ACTIVO
  SUSPENDIDO
}

model Usuario {
  id                    String        @id @default(cuid())
  usuario               String        @unique // nombre de inicio de sesión
  nombreCompleto        String
  correo                String?
  hashContrasena        String // Argon2id
  rol                   Rol
  estado                EstadoUsuario @default(ACTIVO)
  totpSecretoCifrado    String? // AES-256-GCM con la clave maestra
  totpActivo            Boolean       @default(false)
  totpUltimoCodigoHash  String? // evita reutilizar el mismo código dentro de su ventana
  intentosFallidos      Int           @default(0)
  bloqueadoHasta        DateTime?
  debeCambiarContrasena Boolean       @default(true)
  ultimoAcceso          DateTime?
  creadoEn              DateTime      @default(now())
  actualizadoEn         DateTime      @updatedAt

  sesiones               Sesion[]
  expedientesResponsable Expediente[]   @relation("responsable")
  documentos             Documento[]
  generaciones           Generacion[]
  dispositivosAprobados  Dispositivo[]
  plantillasCargadas     Plantilla[]    @relation("cargadaPor")
  notificaciones         Notificacion[]
  suscripcionesPush      SuscripcionPush[]

  @@map("usuarios")
}

// ---------------------------------------------------------------- Dispositivos y sesiones

enum EstadoDispositivo {
  PENDIENTE
  APROBADO
  REVOCADO
}

model Dispositivo {
  id             String            @id @default(cuid())
  nombre         String // p. ej. "Recepción – equipo 2"
  tokenHash      String            @unique // SHA-256 del token firmado entregado en cookie
  huella         String? // huella del navegador (dato complementario)
  estado         EstadoDispositivo @default(PENDIENTE)
  ipRegistro     String?
  agenteUsuario  String?
  aprobadoPor    Usuario?          @relation(fields: [aprobadoPorId], references: [id])
  aprobadoPorId  String?
  aprobadoEn     DateTime?
  ultimoAcceso   DateTime?
  creadoEn       DateTime          @default(now())

  sesiones Sesion[]

  @@map("dispositivos")
}

model Sesion {
  id               String       @id @default(cuid())
  tokenHash        String       @unique
  usuario          Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId        String
  dispositivo      Dispositivo? @relation(fields: [dispositivoId], references: [id])
  dispositivoId    String?
  ip               String?
  agenteUsuario    String?
  remota           Boolean      @default(false) // fuera de la red de la oficina (solo administrador)
  segundoFactorOk  Boolean      @default(false)
  creadaEn         DateTime     @default(now())
  ultimaActividad  DateTime     @default(now())
  expiraEn         DateTime
  revocadaEn       DateTime?
  motivoRevocacion String?

  @@index([usuarioId])
  @@map("sesiones")
}

// ---------------------------------------------------------------- Biblioteca de plantillas

// Escrituras modelo de la notaría: la carga inicial (carpeta de minutas, scripts/cargar-biblioteca.ts) y
// las que agrega el revisor. El .docx va cifrado en el almacenamiento; aquí quedan los datos para buscar.
model Plantilla {
  id            String   @id @default(cuid())
  nombre        String // del nombre del archivo, sin el número inicial
  categoria     String // carpeta del acto: COMPRAVENTA, HIPOTECA, LEASING…
  subcategoria  String? // subcarpeta: el banco (BANCOLOMBIA, FNA…) o la clase de oficio
  anio          Int
  fecha         DateTime // última modificación del archivo (o la que indique el revisor)
  nombreArchivo String
  tamano        Int
  hashSha256    String   @unique
  rutaCifrada   String
  // Texto para buscar: nombre, categoría, subcategoría y el comienzo de la escritura (mayúsculas, sin tildes)
  busqueda      String
  caracteres    Int      @default(0)
  activa        Boolean  @default(true)
  origen        String   @default("CARGA_INICIAL") // CARGA_INICIAL | REVISOR
  cargadaPor    Usuario? @relation("cargadaPor", fields: [cargadaPorId], references: [id], onDelete: SetNull)
  cargadaPorId  String?
  creadaEn      DateTime @default(now())

  expedientes Expediente[]

  @@index([categoria, anio])
  @@index([fecha])
  @@map("plantillas")
}

// ---------------------------------------------------------------- Escrituras (expedientes)

model Expediente {
  id              String     @id @default(cuid())
  numeroInterno   String     @unique // EXP-AAAA-NNNNN
  titulo          String? // descripción corta que escribe el digitador
  // La plantilla de la biblioteca o, si es personal, el .docx que cargó el digitador (cifrado)
  plantilla       Plantilla? @relation(fields: [plantillaId], references: [id], onDelete: SetNull)
  plantillaId     String?
  plantillaNombre String
  plantillaRuta   String? // solo plantilla personal
  observaciones   String? // indicaciones del digitador para la IA, antes de generar
  responsable     Usuario    @relation("responsable", fields: [responsableId], references: [id])
  responsableId   String
  creadoEn        DateTime   @default(now())
  actualizadoEn   DateTime   @updatedAt

  documentos   Documento[]
  generaciones Generacion[]

  @@index([responsableId])
  @@map("expedientes")
}

model Documento {
  id             String     @id @default(cuid())
  expediente     Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  expedienteId   String
  nombreOriginal String
  mime           String
  tamano         Int
  paginas        Int?
  hashSha256     String // del archivo original (integridad)
  rutaCifrada    String
  estadoLectura  String     @default("PENDIENTE") // PENDIENTE | EN_CURSO | LEIDO | ERROR
  // Lo que la IA leyó del documento (src/lib/servicios/documentos.ts): se lee una sola vez y se reutiliza
  lectura        Json?
  errorLectura   String?
  subidoPor      Usuario    @relation(fields: [subidoPorId], references: [id])
  subidoPorId    String
  creadoEn       DateTime   @default(now())
  actualizadoEn  DateTime   @default(now()) @updatedAt

  @@index([expedienteId])
  @@map("documentos")
}

// Cada vez que se genera la escritura: avance por etapas, el Word resultante y la revisión de la IA
model Generacion {
  id              String     @id @default(cuid())
  expediente      Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  expedienteId    String
  version         Int
  estado          String     @default("EN_CURSO") // EN_CURSO | COMPLETADA | ERROR
  error           String?
  progreso        Json? // etapa, turno y lo acumulado (src/lib/servicios/generacion.ts)
  resultado       Json? // resumen, advertencias, faltantes y cambios aplicados
  observaciones   String? // las observaciones con que se generó
  plantillaNombre String
  rutaDocx        String?
  hashSha256      String?
  modelo          String?
  generadaPor     Usuario    @relation(fields: [generadaPorId], references: [id])
  generadaPorId   String
  creadaEn        DateTime   @default(now())
  actualizadaEn   DateTime   @default(now()) @updatedAt // latido: si deja de cambiar, la etapa se cortó

  @@unique([expedienteId, version])
  @@map("generaciones")
}

// ---------------------------------------------------------------- IA

// Una fila por cada llamada a la API de Claude: tokens y costo, con quién la hizo y sobre qué.
// Sin relaciones: el gasto se conserva aunque se borre la escritura, la plantilla o el usuario.
model ConsumoIA {
  id                   String   @id @default(cuid())
  creadoEn             DateTime @default(now())
  usuarioId            String? // quien disparó la llamada
  expedienteId         String? // la escritura
  plantillaId          String? // registros anteriores: revisión o corrección de plantillas
  analisisId           String? // la generación (generaciones) o, en registros anteriores, el análisis
  revisionId           String? // registros anteriores: revisión de una escritura ya hecha
  proposito            String // LECTURA | REDACCION (anteriores: EXTRACCION, REVISION, PLANTILLA, ESCRITURA)
  modelo               String
  tokensEntrada        Int      @default(0)
  tokensSalida         Int      @default(0)
  tokensCacheLectura   Int      @default(0)
  tokensCacheEscritura Int      @default(0)
  costoUSD             Float    @default(0) // con el precio vigente al momento de la llamada (src/lib/ia/precios.ts)
  historico            Boolean  @default(false) // cargado de analisis_ia: el usuario es el responsable del expediente

  @@index([creadoEn])
  @@index([usuarioId, creadoEn])
  @@index([expedienteId])
  @@index([revisionId])
  @@map("consumo_ia")
}

// ---------------------------------------------------------------- Auditoría, alertas y configuración

// Registro inmodificable: un disparador en PostgreSQL bloquea UPDATE y DELETE,
// y cada fila encadena el hash de la anterior (cualquier alteración rompe la cadena).
model Auditoria {
  id             BigInt   @id @default(autoincrement())
  fecha          DateTime @default(now())
  usuarioId      String?
  usuarioNombre  String?
  dispositivoId  String?
  ip             String?
  accion         String
  entidad        String?
  entidadId      String?
  detalle        Json?
  hashAnterior   String
  hash           String   @unique

  @@index([fecha])
  @@index([usuarioId])
  @@index([accion])
  @@map("auditoria")
}

model Alerta {
  id        String   @id @default(cuid())
  tipo      String // DISPOSITIVO_NO_AUTORIZADO | BLOQUEO_USUARIO | IP_NO_PERMITIDA | ACTIVIDAD_INUSUAL | …
  severidad String // ALTA | MEDIA | BAJA
  mensaje   String
  datos     Json?
  atendida  Boolean  @default(false)
  creadaEn  DateTime @default(now())

  @@index([atendida, creadaEn])
  @@map("alertas")
}

model Configuracion {
  clave           String   @id
  valor           Json
  actualizadoPor  String?
  actualizadoEn   DateTime @updatedAt

  @@map("configuracion")
}

// Contador para limitar peticiones (rate limiting) por clave e intervalo
model LimitePeticiones {
  clave      String   @id
  conteo     Int
  ventanaFin DateTime

  @@map("limite_peticiones")
}

// Avisos para el usuario: lecturas y escrituras terminadas…
model Notificacion {
  id        String    @id @default(cuid())
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  titulo    String
  mensaje   String
  enlace    String?
  leidaEn   DateTime?
  creadaEn  DateTime  @default(now())

  @@index([usuarioId, creadaEn])
  @@map("notificaciones")
}

/// Navegadores donde la persona activó los avisos: el servidor les envía cada notificación como
/// aviso push, que llega aunque la pestaña esté dormida o cerrada (src/lib/servicios/push.ts).
model SuscripcionPush {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  creadaEn  DateTime @default(now())

  @@index([usuarioId])
  @@map("suscripciones_push")
}
