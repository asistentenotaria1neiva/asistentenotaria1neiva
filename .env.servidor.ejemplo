# .env del SERVIDOR LOCAL de la notaría (Windows). Copie este archivo como .env en la carpeta de la
# aplicación y complete los valores. NUNCA lo suba al repositorio ni lo comparta por correo o chat.
# Guía completa: docs/servidor_local.md

# --- Base de datos: PostgreSQL instalado en este mismo equipo ---
# Usuario y contraseña que creó en el paso 3 de la guía (solo letras y números en la contraseña).
DATABASE_URL="postgresql://notaria:CONTRASENA_BD@127.0.0.1:5432/escrituracion"

# --- Claves de cifrado: COPIE LAS MISMAS de Vercel (Settings → Environment Variables) ---
# Si CLAVE_MAESTRA no es exactamente la misma, los documentos migrados NO se pueden abrir.
# Si CLAVE_FIRMA cambia, todas las sesiones y equipos aprobados quedan inválidos.
CLAVE_MAESTRA=
CLAVE_FIRMA=

# --- API de Claude (Anthropic): las mismas de Vercel ---
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_ADMIN_KEY=
CLAUDE_MODELO_DOCUMENTOS=
CLAUDE_MODELO_EXPEDIENTE=
CLAUDE_MODELO_REDACCION=
CLAUDE_MODELO_PLANTILLAS=
CLAUDE_MODELO_RESPALDO=
CLAUDE_ESFUERZO_DOCUMENTOS=
CLAUDE_ESFUERZO_EXPEDIENTE=
CLAUDE_ESFUERZO_REDACCION=
CLAUDE_ESFUERZO_PLANTILLAS=
CLAUDE_REDACCION_DOCUMENTOS=
CLAUDE_FALLBACKS=default
CLAUDE_CONCURRENCIA=

# --- Red ---
# IP pública de la oficina (la misma que está en Configuración del panel). Con el túnel, todos entran
# por el dominio, y desde la oficina se ve esa IP.
IPS_OFICINA=
# true: la IP real llega por Cloudflare Tunnel (CF-Connecting-IP). La app escucha solo en 127.0.0.1.
CONFIAR_EN_PROXY=true
# Dirección pública de la aplicación (el dominio comprado, con https)
URL_APLICACION=https://escrituras.SU-DOMINIO.com.co
DOMINIO=escrituras.SU-DOMINIO.com.co

# --- Archivos cifrados: carpeta local del servidor (no Supabase) ---
# Deje SUPABASE_URL y SUPABASE_CLAVE_SERVICIO VACÍAS después de la migración: así la app usa la carpeta.
# Durante la migración (paso 6 de la guía) póngales temporalmente los valores de Vercel.
SUPABASE_URL=
SUPABASE_CLAVE_SERVICIO=
SUPABASE_BUCKET=documentos
RUTA_ALMACENAMIENTO=D:\Notaria\almacenamiento

# --- Conversión a PDF (opcional, no se usa hoy) ---
PDF_CONVERSOR_URL=

# --- Avisos push: COPIE LAS MISMAS de Vercel ---
VAPID_PUBLICA=
VAPID_PRIVADA=
VAPID_CONTACTO=

# --- Limpieza automática: en el servidor hay espacio de sobra ---
# Se conservan los PDF soporte 180 días y las escrituras 10 años (cambie a su gusto).
LIMPIEZA_ESCRITURAS_DIAS=3650
LIMPIEZA_PDF_DIAS=180
LIMPIEZA_PDF_MAXIMO_MB=200000
