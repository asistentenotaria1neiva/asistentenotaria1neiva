# Proxy inverso con TLS automático. La aplicación agrega las demás cabeceras de seguridad.
{$DOMINIO} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}
	# Límite de tamaño de carga (documentos soporte)
	request_body {
		max_size 30MB
	}
	reverse_proxy app:3000 {
		# La app confía solo en esta cabecera para conocer la IP real del cliente
		header_up X-Real-IP {remote_host}
	}
}
