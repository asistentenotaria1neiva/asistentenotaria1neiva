{
  "name": "escrituracion-notaria-1",
  "version": "0.1.0",
  "private": true,
  "description": "Asistente de escrituración con IA – Notaría Primera del Círculo de Neiva (Automind)",
  "scripts": {
    "fase0": "node herramientas/fase0/ejecutar_fase0.js",
    "plantillas:modelos": "node herramientas/plantillas/crear_modelos.js",
    "plantillas:construir": "node herramientas/plantillas/exportar_catalogo.js && node herramientas/plantillas/construir.js",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prueba": "vitest run",
    "tipos": "tsc --noEmit",
    "db:migrar": "prisma migrate deploy",
    "prueba:integracion": "vitest run --config vitest.integracion.mts",
    "prueba:e2e": "next build && playwright test",
    "datos:prueba": "tsx --tsconfig tsconfig.scripts.json --env-file=.env scripts/cargar-datos-prueba.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "angular-expressions": "^1.7.1",
    "docxtemplater": "^3.71.1",
    "next": "^16.4.2",
    "otplib": "^13.5.0",
    "pizzip": "^3.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  }
}
