# Copie este archivo como .env y complete los valores. NUNCA suba .env al repositorio.
# En Vercel, las mismas variables se definen en Settings → Environment Variables.

# --- Base de datos (Supabase → Connect → Direct) ---
# La app usa el Transaction pooler (puerto 6543). Contraseña de solo letras y números,
# o con los caracteres especiales codificados (p. ej. / → %2F).
DATABASE_URL="postgresql://postgres.REF_PROYECTO:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Las migraciones (npx prisma migrate deploy) van por el Session pooler (puerto 5432):
#   DATABASE_URL="postgresql://postgres.REF_PROYECTO:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres" npx prisma migrate deploy

# --- Claves de cifrado (32 bytes en base64). Genere con:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CLAVE_MAESTRA cifra documentos y secretos TOTP. Si se pierde, los documentos no se pueden recuperar:
# guárdela también fuera de Vercel (gestor de secretos / sobre sellado del notario).
# Debe ser la misma en todos los entornos que compartan la base y el bucket.
CLAVE_MAESTRA=
# Firma de los tokens de dispositivo y de sesión
CLAVE_FIRMA=

# --- API de Claude (Anthropic): SOLO en el servidor ---
ANTHROPIC_API_KEY=
# Solo si la clave no está asignada a un workspace: ID del workspace (wrkspc_...) de la Consola
ANTHROPIC_WORKSPACE_ID=
# Clave de administrador (sk-ant-admin...) para ver el costo real en Estadísticas.
# Vacía = se intenta con ANTHROPIC_API_KEY (sirve solo si esa clave no está asignada a un workspace)
ANTHROPIC_ADMIN_KEY=
# Modelos por tarea. Vacío = el predeterminado, el más económico que la resuelve bien:
# documentos claude-haiku-5-5, expediente claude-sonnet-5-5, plantillas claude-sonnet-5-5
CLAUDE_MODELO_DOCUMENTOS=
CLAUDE_MODELO_EXPEDIENTE=
CLAUDE_MODELO_PLANTILLAS=
# Si el modelo de documentos (Haiku) declina el contenido, se repite con este (vacío = claude-sonnet-5-5)
CLAUDE_MODELO_RESPALDO=
# Esfuerzo de razonamiento: low | medium | high | xhigh | max. Vacío = documentos medium, expediente high, plantillas medium
CLAUDE_ESFUERZO_DOCUMENTOS=
CLAUDE_ESFUERZO_EXPEDIENTE=
CLAUDE_ESFUERZO_PLANTILLAS=
# Respaldo automático del servidor ante rechazos por política ("default" o vacío para desactivar)
CLAUDE_FALLBACKS=default

# --- Red y sesiones (valores iniciales; luego se administran desde el panel) ---
# IPs públicas de la oficina separadas por coma. Vacío = permitir todas SOLO en desarrollo;
# en producción vacío = nadie puede ingresar.
IPS_OFICINA=
# true en Vercel (la IP real llega en X-Real-IP). false en desarrollo local.
CONFIAR_EN_PROXY=false
# Dirección pública de la aplicación (p. ej. https://escrituracion.midominio.com). Los análisis largos la usan
# para encadenar sus etapas. Vacío = la del dominio por el que entró la petición.
URL_APLICACION=

# --- Almacenamiento de documentos cifrados (Supabase → Storage, bucket PRIVADO) ---
# Si SUPABASE_URL y SUPABASE_CLAVE_SERVICIO tienen valor, los documentos se guardan en Supabase;
# vacías = carpeta local RUTA_ALMACENAMIENTO (solo para desarrollo sin conexión).
SUPABASE_URL=https://REF_PROYECTO.supabase.co
# Clave secret (sb_secret_...) o service_role. Nunca la publishable. Solo en el servidor.
SUPABASE_CLAVE_SERVICIO=
SUPABASE_BUCKET=documentos
RUTA_ALMACENAMIENTO=./almacenamiento

# --- Conversión a PDF (opcional): URL de un servicio Gotenberg. Vacío = borradores solo en Word ---
PDF_CONVERSOR_URL=
