# Copie este archivo como .env y complete los valores. NUNCA suba .env al repositorio.

# --- Base de datos (solo accesible desde el servidor) ---
DATABASE_URL="postgresql://escrituracion:desarrollo_local_solamente@127.0.0.1:5432/escrituracion"
# Base exclusiva para las pruebas de integración (se borra y recrea en cada ejecución)
DATABASE_URL_PRUEBA="postgresql://escrituracion:desarrollo_local_solamente@127.0.0.1:5432/escrituracion_prueba"
POSTGRES_DB=escrituracion
POSTGRES_USER=escrituracion
POSTGRES_PASSWORD=cambie_esta_clave

# --- Dominio público (producción, para el certificado TLS) ---
DOMINIO=escrituracion.ejemplo.com.co

# --- Claves de cifrado (32 bytes en base64). Genere con:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CLAVE_MAESTRA cifra documentos y secretos TOTP. Si se pierde, los documentos no se pueden recuperar:
# guárdela también fuera del servidor (gestor de secretos / sobre sellado del notario).
CLAVE_MAESTRA=
# Firma de los tokens de dispositivo y de sesión
CLAVE_FIRMA=

# --- API de Claude (Anthropic): SOLO en el servidor ---
ANTHROPIC_API_KEY=
# Modelos configurables por tarea (por defecto el modelo vigente más preciso)
CLAUDE_MODELO_EXTRACCION=claude-opus-5-5
CLAUDE_MODELO_REVISION=claude-opus-5-5
# Esfuerzo de razonamiento: low | medium | high | xhigh | max
CLAUDE_ESFUERZO_EXTRACCION=high
CLAUDE_ESFUERZO_REVISION=high
# Respaldo automático del servidor ante rechazos por política ("default" o vacío para desactivar)
CLAUDE_FALLBACKS=default

# --- Red y sesiones (valores iniciales; luego se administran desde el panel) ---
# IPs públicas de la oficina separadas por coma (vacío = permitir todas, solo en desarrollo)
IPS_OFICINA=
# En producción detrás del proxy: confiar en X-Real-IP
CONFIAR_EN_PROXY=true

# --- Conversión a PDF (Gotenberg). Vacío = solo .docx ---
PDF_CONVERSOR_URL=http://127.0.0.1:3001

# --- Almacenamiento de documentos cifrados ---
RUTA_ALMACENAMIENTO=./almacenamiento

# --- Copias de seguridad (scripts/respaldo.sh) ---
# Clave de cifrado de las copias: GUÁRDELA SEPARADA de las copias y de CLAVE_MAESTRA
CLAVE_RESPALDO=
DIR_RESPALDOS=./respaldos
DIAS_RETENCION_RESPALDOS=30
# Ubicación separada: destino de rclone (p. ej. "nube:notaria-respaldos") o ruta rsync
DESTINO_REMOTO=
